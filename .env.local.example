# =============================================================================
# REQUIRED — MongoDB connection (a local MongoDB server works out of the box)
# =============================================================================

# Connection string
MONGODB_URI=mongodb://127.0.0.1:27017

# Database name
MONGODB_DB=clubdee

# Secret used to sign session cookies (any long random string; required in production)
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=

# Local app URL
NEXT_PUBLIC_APP_URL=http://localhost:3000
